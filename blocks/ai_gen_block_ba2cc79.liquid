          {{ block.settings.cta_text }}
        </a>
      {% endif %}
    </div>
  </div>
</lb-about-pack-lightbox-{{ ai_gen_id }}>

<script>
  (function() {
    class LbAboutPackLightbox{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.overlay = this.querySelector('[data-overlay]');
        this.panel = this.querySelector('[data-panel]');
        this.closeBtn = this.querySelector('[data-close]');
        this.thumbnails = this.querySelectorAll('[data-thumbnail]');
        this.mainImage = this.querySelector('[data-main-image]');
      }

      connectedCallback() {
        this.setupEventListeners();
        this.setupTriggers();
      }

      setupEventListeners() {
        this.closeBtn.addEventListener('click', () => this.close());
        this.overlay.addEventListener('click', () => this.close());

        this.thumbnails.forEach((thumb) => {
          thumb.addEventListener('click', () => {
            this.thumbnails.forEach((t) => t.classList.remove('active'));
            thumb.classList.add('active');
            
            const imageUrl = thumb.getAttribute('data-image-url');
            const mainImg = this.mainImage.querySelector('img');
            if (mainImg && imageUrl) {
              mainImg.src = imageUrl;
            }
          });
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.panel.classList.contains('active')) {
            this.close();
          }
        });
      }

      setupTriggers() {
        document.addEventListener('click', (e) => {
          const trigger = e.target.closest('[data-lb-about-pack-trigger]');
          if (trigger) {
            e.preventDefault();
            this.open();
          }
        });
      }

      open() {
        this.overlay.classList.add('active');
        this.panel.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      close() {
        this.overlay.classList.remove('active');
        this.panel.classList.remove('active');
        document.body.style.overflow = '';
      }
    }

    customElements.define('lb-about-pack-lightbox-{{ ai_gen_id }}', LbAboutPackLightbox{{ ai_gen_id }});
  })();
</script>


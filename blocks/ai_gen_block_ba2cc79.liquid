{% doc %}
  @prompt
    Create a dark-luxury styled product detail lightbox section called "LB About Pack" for a Shopify theme. It should slide in as an overlay panel (not a full-screen modal) when triggered from a product feature card. The lightbox should include: a multi-photo image gallery with thumbnail navigation, a product title and full description area, a license comparison block showing Commercial License vs Personal License options with a feature list for each, a "What's Included" section with icons or checkmarks, a close button, and a CTA button linking to the product page. Style should match a dark-luxury editorial aesthetic: dark background (#0a0a0a), white headings, muted grey subtext (#aaaaaa), and a teal accent colour (#7dd8e8). The section should be configurable via theme editor settings (images, text, license details). It should be triggered by a data attribute on external elements.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .lb-about-pack-lightbox-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    right: -100%;
    width: 100%;
    max-width: {{ block.settings.panel_width }}px;
    height: 100vh;
    background-color: {{ block.settings.background_color }};
    z-index: 9999;
    overflow-y: auto;
    transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: -8px 0 40px rgba(0, 0, 0, 0.6);
    display: block;
  }

  .lb-about-pack-lightbox-{{ ai_gen_id }}.active {
    right: 0;
  }

  .lb-about-pack-overlay-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.85);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .lb-about-pack-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .lb-about-pack-close-{{ ai_gen_id }} {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.heading_color }};
    transition: all 0.3s ease;
    z-index: 10;
  }

  .lb-about-pack-close-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.accent_color }};
    border-color: {{ block.settings.accent_color }};
    transform: rotate(90deg);
  }

  .lb-about-pack-content-{{ ai_gen_id }} {
    padding: 60px 40px 40px;
  }

  .lb-about-pack-gallery-{{ ai_gen_id }} {
    margin-bottom: 40px;
  }

  .lb-about-pack-main-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #1a1a1a;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 16px;
  }

  .lb-about-pack-main-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lb-about-pack-thumbnails-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding-bottom: 8px;
  }

  .lb-about-pack-thumbnail-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border-radius: 4px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.3s ease;
  }

  .lb-about-pack-thumbnail-{{ ai_gen_id }}.active {
    border-color: {{ block.settings.accent_color }};
  }

  .lb-about-pack-thumbnail-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lb-about-pack-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    font-weight: 600;
    line-height: 1.2;
  }

  .lb-about-pack-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin-bottom: 40px;
  }

  .lb-about-pack-section-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 20px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .lb-about-pack-licenses-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 40px;
  }

  .lb-about-pack-license-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 8px;
    padding: 24px;
  }

  .lb-about-pack-license-title-{{ ai_gen_id }} {
    font-size: 18px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    font-weight: 600;
  }

  .lb-about-pack-license-features-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .lb-about-pack-license-feature-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin-bottom: 12px;
    padding-left: 24px;
    position: relative;
  }

  .lb-about-pack-license-feature-{{ ai_gen_id }}::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: {{ block.settings.accent_color }};
    font-weight: bold;
  }

  .lb-about-pack-included-{{ ai_gen_id }} {
    margin-bottom: 40px;
  }

  .lb-about-pack-included-list-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }

  .lb-about-pack-included-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
  }

  .lb-about-pack-included-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    color: {{ block.settings.accent_color }};
  }

  .lb-about-pack-cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 40px;
    background-color: {{ block.settings.cta_background }};
    color: {{ block.settings.cta_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.cta_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    transition: all 0.3s ease;
    text-align: center;
    border: 1px solid {{ block.settings.cta_background }};
  }

  .lb-about-pack-cta-{{ ai_gen_id }}:hover {
    background-color: transparent;
    color: {{ block.settings.cta_background }};
  }

  @media screen and (max-width: 768px) {
    .lb-about-pack-lightbox-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .lb-about-pack-content-{{ ai_gen_id }} {
      padding: 60px 20px 40px;
    }

    .lb-about-pack-licenses-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .lb-about-pack-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<lb-about-pack-lightbox-{{ ai_gen_id }} {{ block.shopify_attributes }}>
  <div class="lb-about-pack-overlay-{{ ai_gen_id }}" data-overlay></div>
  
  <div class="lb-about-pack-lightbox-{{ ai_gen_id }}" data-panel>
    <button class="lb-about-pack-close-{{ ai_gen_id }}" data-close aria-label="Close lightbox">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="lb-about-pack-content-{{ ai_gen_id }}">
      {% if block.settings.image_1 or block.settings.image_2 or block.settings.image_3 or block.settings.image_4 %}
        <div class="lb-about-pack-gallery-{{ ai_gen_id }}">
          <div class="lb-about-pack-main-image-{{ ai_gen_id }}" data-main-image>
            {% if block.settings.image_1 %}
              <img 
                src="{{ block.settings.image_1 | image_url: width: 1200 }}" 
                alt="{{ block.settings.image_1.alt | escape }}"
                loading="lazy"
              >
            {% endif %}
          </div>

          <div class="lb-about-pack-thumbnails-{{ ai_gen_id }}">
            {% if block.settings.image_1 %}
              <div class="lb-about-pack-thumbnail-{{ ai_gen_id }} active" data-thumbnail data-image-url="{{ block.settings.image_1 | image_url: width: 1200 }}">
                <img 
                  src="{{ block.settings.image_1 | image_url: width: 100 }}" 
                  alt="{{ block.settings.image_1.alt | escape }}"
                  loading="lazy"
                >
              </div>
            {% endif %}
            {% if block.settings.image_2 %}
              <div class="lb-about-pack-thumbnail-{{ ai_gen_id }}" data-thumbnail data-image-url="{{ block.settings.image_2 | image_url: width: 1200 }}">
                <img 
                  src="{{ block.settings.image_2 | image_url: width: 100 }}" 
                  alt="{{ block.settings.image_2.alt | escape }}"
                  loading="lazy"
                >
              </div>
            {% endif %}
            {% if block.settings.image_3 %}
              <div class="lb-about-pack-thumbnail-{{ ai_gen_id }}" data-thumbnail data-image-url="{{ block.settings.image_3 | image_url: width: 1200 }}">
                <img 
                  src="{{ block.settings.image_3 | image_url: width: 100 }}" 
                  alt="{{ block.settings.image_3.alt | escape }}"
                  loading="lazy"
                >
              </div>
            {% endif %}
            {% if block.settings.image_4 %}
              <div class="lb-about-pack-thumbnail-{{ ai_gen_id }}" data-thumbnail data-image-url="{{ block.settings.image_4 | image_url: width: 1200 }}">
                <img 
                  src="{{ block.settings.image_4 | image_url: width: 100 }}" 
                  alt="{{ block.settings.image_4.alt | escape }}"
                  loading="lazy"
                >
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.product_title != blank %}
        <h2 class="lb-about-pack-title-{{ ai_gen_id }}">{{ block.settings.product_title }}</h2>
      {% endif %}

      {% if block.settings.product_description != blank %}
        <div class="lb-about-pack-description-{{ ai_gen_id }}">
          {{ block.settings.product_description }}
        </div>
      {% endif %}

      <h3 class="lb-about-pack-section-heading-{{ ai_gen_id }}">{{ block.settings.license_heading }}</h3>
      <div class="lb-about-pack-licenses-{{ ai_gen_id }}">
        <div class="lb-about-pack-license-card-{{ ai_gen_id }}">
          <h4 class="lb-about-pack-license-title-{{ ai_gen_id }}">{{ block.settings.commercial_title }}</h4>
          <ul class="lb-about-pack-license-features-{{ ai_gen_id }}">
            {% if block.settings.commercial_feature_1 != blank %}
              <li class="lb-about-pack-license-feature-{{ ai_gen_id }}">{{ block.settings.commercial_feature_1 }}</li>
            {% endif %}
            {% if block.settings.commercial_feature_2 != blank %}
              <li class="lb-about-pack-license-feature-{{ ai_gen_id }}">{{ block.settings.commercial_feature_2 }}</li>
            {% endif %}
            {% if block.settings.commercial_feature_3 != blank %}
              <li class="lb-about-pack-license-feature-{{ ai_gen_id }}">{{ block.settings.commercial_feature_3 }}</li>
            {% endif %}
            {% if block.settings.commercial_feature_4 != blank %}
              <li class="lb-about-pack-license-feature-{{ ai_gen_id }}">{{ block.settings.commercial_feature_4 }}</li>
            {% endif %}
          </ul>
        </div>

        <div class="lb-about-pack-license-card-{{ ai_gen_id }}">
          <h4 class="lb-about-pack-license-title-{{ ai_gen_id }}">{{ block.settings.personal_title }}</h4>
          <ul class="lb-about-pack-license-features-{{ ai_gen_id }}">
            {% if block.settings.personal_feature_1 != blank %}
              <li class="lb-about-pack-license-feature-{{ ai_gen_id }}">{{ block.settings.personal_feature_1 }}</li>
            {% endif %}
            {% if block.settings.personal_feature_2 != blank %}
              <li class="lb-about-pack-license-feature-{{ ai_gen_id }}">{{ block.settings.personal_feature_2 }}</li>
            {% endif %}
            {% if block.settings.personal_feature_3 != blank %}
              <li class="lb-about-pack-license-feature-{{ ai_gen_id }}">{{ block.settings.personal_feature_3 }}</li>
            {% endif %}
            {% if block.settings.personal_feature_4 != blank %}
              <li class="lb-about-pack-license-feature-{{ ai_gen_id }}">{{ block.settings.personal_feature_4 }}</li>
            {% endif %}
          </ul>
        </div>
      </div>

      <h3 class="lb-about-pack-section-heading-{{ ai_gen_id }}">{{ block.settings.included_heading }}</h3>
      <div class="lb-about-pack-included-{{ ai_gen_id }}">
        <div class="lb-about-pack-included-list-{{ ai_gen_id }}">
          {% if block.settings.included_item_1 != blank %}
            <div class="lb-about-pack-included-item-{{ ai_gen_id }}">
              <svg class="lb-about-pack-included-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{{ block.settings.included_item_1 }}</span>
            </div>
          {% endif %}
          {% if block.settings.included_item_2 != blank %}
            <div class="lb-about-pack-included-item-{{ ai_gen_id }}">
              <svg class="lb-about-pack-included-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{{ block.settings.included_item_2 }}</span>
            </div>
          {% endif %}
          {% if block.settings.included_item_3 != blank %}
            <div class="lb-about-pack-included-item-{{ ai_gen_id }}">
              <svg class="lb-about-pack-included-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{{ block.settings.included_item_3 }}</span>
            </div>
          {% endif %}
          {% if block.settings.included_item_4 != blank %}
            <div class="lb-about-pack-included-item-{{ ai_gen_id }}">
              <svg class="lb-about-pack-included-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{{ block.settings.included_item_4 }}</span>
            </div>
          {% endif %}
          {% if block.settings.included_item_5 != blank %}
            <div class="lb-about-pack-included-item-{{ ai_gen_id }}">
              <svg class="lb-about-pack-included-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{{ block.settings.included_item_5 }}</span>
            </div>
          {% endif %}
          {% if block.settings.included_item_6 != blank %}
            <div class="lb-about-pack-included-item-{{ ai_gen_id }}">
              <svg class="lb-about-pack-included-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
